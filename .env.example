# Copy to .env. Everything runs with no keys at all; these are optional.

# Tier 2 backend: local_intent (default, ONNX embeddings + trained head), mock, or gemini
TIER2_BACKEND=local_intent

# Optional external LLM backend: OFF by default. Not for production use with customer mail
# (free tiers have rate limits and data-usage terms; see docs/DESIGN.md).
ENABLE_EXTERNAL_LLM=false
GEMINI_API_KEY=

# Simulate real wall-clock latency of mocked external services (true for API/demo, false for batch eval)
SIMULATE_SERVICE_LATENCY=true
